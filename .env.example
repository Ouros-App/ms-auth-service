APP_NAME=ouros-auth-service
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_PORT=8000

# Use a dedicated read-only PostgreSQL role in production.
DATABASE_URL=postgresql://ouros_auth_reader:change-me@localhost:5432/ouros
DATABASE_MIN_POOL_SIZE=1
DATABASE_MAX_POOL_SIZE=10
DATABASE_COMMAND_TIMEOUT_SECONDS=5
